# Skopiuj ten plik jako .env i uzupełnij
# Klucz API Claude (console.anthropic.com) - włącza asystenta
ANTHROPIC_API_KEY=
# Port serwera
PORT=3000
# Strefa czasowa rodziny (godziny przypomnień)
TZ_FAMILY=Europe/Warsaw
# Kontakt wymagany przez powiadomienia push (dowolny Twój e-mail)
VAPID_SUBJECT=mailto:twoj-adres@example.com
